# AWS Bedrock — bearer token auth (used in place of AWS access keys)
AWS_BEARER_TOKEN_BEDROCK=your-bearer-token-here
AWS_REGION=us-east-1

# Local CSV files (download from Google Sheets as CSV)
PARTNER_CSV=./partner-links.csv
COMPLIANCE_RULES_CSV=./compliance-rules.csv

# Optional: local Chrome executable path (auto-detected if omitted)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: headless mode (default true; set false to watch the browser)
# HEADLESS=false
